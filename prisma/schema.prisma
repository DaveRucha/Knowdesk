generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─── ENUMS ────────────────────────────────────────────────

enum Role {
  ADMIN
  EMPLOYEE
}

enum DocumentStatus {
  PROCESSING
  READY
  FAILED
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum AccessLevel {
  ALL
  ADMIN_ONLY
}

// ─── CORE TABLES ──────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  users     User[]
  documents Document[]
  sops      SOP[]
  queries   Query[]
  jobs      Job[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  role           Role      @default(EMPLOYEE)
  organizationId String?   // ← add ? here
  createdAt      DateTime  @default(now())
  emailVerified  DateTime?
  image          String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  queries      Query[]
  accounts     Account[]
  sessions     Session[]
}

model Document {
  id             String         @id @default(cuid())
  name           String
  s3Key          String
  status         DocumentStatus @default(PROCESSING)
  accessLevel    AccessLevel    @default(ALL)
  uploadedById   String
  organizationId String
  createdAt      DateTime       @default(now())
  processedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks       Chunk[]
  job          Job?
}

model SOP {
  id             String      @id @default(cuid())
  title          String
  content        String
  accessLevel    AccessLevel @default(ALL)
  organizationId String
  createdById    String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chunks       Chunk[]
}

model Chunk {
  id             String                      @id @default(cuid())
  content        String
  embedding      Unsupported("vector(1536)")
  chunkIndex     Int
  pageNumber     Int?
  accessLevel    AccessLevel                 @default(ALL)
  organizationId String
  documentId     String?
  sopId          String?

  document Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sop      SOP?      @relation(fields: [sopId], references: [id], onDelete: Cascade)
}

model Query {
  id             String   @id @default(cuid())
  question       String
  answer         String?
  confidence     Float
  wasAnswered    Boolean
  organizationId String
  askedById      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [askedById], references: [id])
}

model Job {
  id             String    @id @default(cuid())
  documentId     String    @unique
  status         JobStatus @default(QUEUED)
  progress       Int       @default(0)
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  organizationId String

  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])
}

// ─── NEXTAUTH TABLES ──────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}