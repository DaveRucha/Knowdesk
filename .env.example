# Postgres (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}
# Use this instead if Postgres is running standalone, not via docker-compose:
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# NextAuth
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OpenAI (embeddings + chat completions)
OPENAI_API_KEY=your-openai-api-key

# AWS S3 (PDF storage)
AWS_S3_REGION=your-aws-s3-region
AWS_S3_ACCESS_KEY_ID=your-aws-s3-access-key-id
AWS_S3_SECRET_ACCESS_KEY=your-aws-s3-secret-access-key
AWS_S3_BUCKET_NAME=your-aws-s3-bucket-name

# Redis (docker-compose)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=mysecurepassword
# Use these instead if Redis is running standalone, not via docker-compose:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=mysecurepassword

# App URL (used to build invite links sent via email)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (invite emails)
RESEND_API_KEY=your-resend-api-key